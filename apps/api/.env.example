# =====================
# Tablya API — variables d'environnement
# Copier en .env et remplir les valeurs
# =====================

# --- Application ---
NODE_ENV=development
PORT=3001  # web Next.js occupe 3000
API_PREFIX=api/v1

# --- Base de données ---
DATABASE_URL="postgresql://tablya:tablya_dev@localhost:5432/tablya?schema=public"
# Rôle applicatif SANS BYPASSRLS (créé par rls.sql) — utilisé en production
DATABASE_APP_URL="postgresql://tablya_app:tablya_app_dev@localhost:5432/tablya?schema=public"

# --- Redis ---
REDIS_URL="redis://:tablya_dev_redis@localhost:6379"

# --- JWT ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Stockage S3-compatible (MinIO en dev) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="tablya-media"
S3_ACCESS_KEY="tablya"
S3_SECRET_KEY="tablya_dev_minio"
S3_FORCE_PATH_STYLE=true

# --- Paiements (à remplir avec les credentials sandbox) ---
# URL publique de l'API — utilisée pour construire notify_url (CinetPay).
# En dev : http://localhost:3001/api/v1 — en prod : https://api.votredomaine/api/v1
PUBLIC_API_URL="http://localhost:3001/api/v1"
FEDAPAY_BASE_URL="https://api.fedapay.com/v1"
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""          # secret d'endpoint 'wh_...' (dashboard FedaPay)
FEDAPAY_PAYMENT_LINK_TEMPLATE="https://app.fedapay.com/m/{token}"
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
CINETPAY_CHECKOUT_URL="https://api-checkout.cinetpay.com/v2/payment"
CINETPAY_CHECK_URL="https://api-checkout.cinetpay.com/v2/payment/check"

# --- Jobs planifiés (reversements J+1) ---
SCHEDULE_DISABLED=false

# --- Notifications ---
FCM_SERVER_KEY=""
SMS_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""

# --- Observabilité ---
LOG_LEVEL=debug
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
POINTAGE_PIN_SECRET=
